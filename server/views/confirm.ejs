<%- include('partials/header', { title, currentPath }) %>
<section class="panel narrow">
  <h1>Bevestig uw reservatie</h1>

  <!-- Film overzicht met poster -->
  <article class="confirm-movie">
    <% if (movie.poster_url) { %>
      <img src="<%= movie.poster_url %>" alt="<%= movie.titel %>" class="confirm-poster" />
    <% } else { %>
      <div class="confirm-poster-placeholder"></div>
    <% } %>
    <div class="confirm-movie-info">
      <span class="badge"><%= movie.genre %></span>
      <h2><%= movie.titel %></h2>
      <p class="muted">📅 <%= formattedDate %></p>
      <p class="muted">📍 <%= movie.zaal_naam %></p>
    </div>
  </article>

  <!-- Geselecteerde stoelen -->
  <article class="card">
    <h2>🎟️ Geselecteerde stoelen</h2>
    <div class="seat-tags">
      <% selectedSeats.forEach((entry) => { %>
        <span class="seat-tag">Rij <%= entry.seat.row %> · Stoel <%= entry.seat.number %></span>
      <% }) %>
    </div>
    <p class="total">Totaal: €<%= Number(total).toFixed(2) %></p>
  </article>

  <!-- Klantgegevens -->
  <article class="card">
    <h2>Uw gegevens</h2>
    <form method="post" action="/confirm" class="confirm-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>Naam
        <input type="text" name="naam" required 
          value="<%= klant ? klant.naam : '' %>" 
          placeholder="Jan Peeters"
          <%= klant ? 'readonly' : '' %> />
      </label>
      <label>E-mailadres
        <input type="email" name="email" required 
          value="<%= klant ? klant.email : '' %>" 
          placeholder="jan@voorbeeld.be"
          <%= klant ? 'readonly' : '' %> />
      </label>
      <% if (klant) { %>
        <p class="muted" style="font-size:0.85rem;">✅ Ingelogd als <%= klant.naam %></p>
      <% } %>
      <div class="actions">
        <a class="btn alt" href="/seats">Terug</a>
        <button class="btn" type="submit">Bevestig reservering</button>
      </div>
    </form>
  </article>
</section>
<%- include('partials/footer') %>