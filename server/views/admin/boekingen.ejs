<%- include('../partials/header', { title: 'Boekingen', currentPath }) %>

<section class="admin-section">
  <div class="admin-header">
    <h1>Boekingen</h1>
  </div>

  <table class="admin-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Klant</th>
        <th>Film</th>
        <th>Datum</th>
        <th>Totaal</th>
        <th>Detail</th>
      </tr>
    </thead>
    <tbody>
      <% boekingen.forEach(b => { %>
      <tr>
        <td>#<%= b.id %></td>
        <td><%= b.klant_naam %></td>
        <td><%= b.film_titel %></td>
        <td><%= new Date(b.geboekt_op).toLocaleString('nl-BE') %></td>
        <td>€<%= Number(b.totaalbedrag).toFixed(2) %></td>
        <td><a href="/admin/boekingen/<%= b.id %>" class="btn btn-small">Bekijken</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<%- include('../partials/footer') %>