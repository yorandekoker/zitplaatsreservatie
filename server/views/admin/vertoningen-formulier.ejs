<%- include('../partials/header', { title: 'Nieuwe vertoning', currentPath }) %>

<section class="admin-section">
  <div class="admin-header">
    <h1>Nieuwe vertoning</h1>
    <a href="/admin/vertoningen" class="btn btn-small">← Terug</a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <p style="color: var(--brand); font-weight: 600;">⚠️ <%= error %></p>
  <% } %>

  <form method="POST" action="/admin/vertoningen/nieuw" class="admin-form">
    <label>Film
      <select name="film_id" required>
        <% films.forEach(f => { %>
          <option value="<%= f.id %>"><%= f.titel %></option>
        <% }) %>
      </select>
    </label>
    <label>Zaal
      <select name="zaal_id" required>
        <% zalen.forEach(z => { %>
          <option value="<%= z.id %>"><%= z.naam %></option>
        <% }) %>
      </select>
    </label>
    <label>Prijs (€)
      <input type="number" name="prijs" step="0.01" min="0" required />
    </label>

    <div id="datums">
      <label>Datum & tijd
        <input type="datetime-local" name="start_tijd" required />
      </label>
    </div>

    <button type="button" class="btn alt btn-small" id="datumToevoegen">+ Extra datum toevoegen</button>

    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <button type="submit" class="btn btn-primary">Opslaan</button>
  </form>
</section>

<script>
  document.getElementById('datumToevoegen').addEventListener('click', function() {
    const container = document.getElementById('datums');
    const wrapper = document.createElement('div');
    wrapper.className = 'extra-datum';
    wrapper.innerHTML = `
      <label>Extra datum & tijd
        <input type="datetime-local" name="start_tijd" />
      </label>
      <button type="button" class="btn btn-small btn-danger verwijder-datum">Verwijderen</button>
    `;
    container.appendChild(wrapper);

    wrapper.querySelector('.verwijder-datum').addEventListener('click', function() {
      wrapper.remove();
    });
  });
</script>

<%- include('../partials/footer') %>